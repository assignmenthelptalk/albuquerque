---
import Layout from "../../components/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import QuickFacts from "../../components/QuickFacts.astro";
import { site } from "../../lib/site";
import headerImage from "../../assets/images/products-header.jpg";

const primaryCta = site.phoneNumber && site.phoneNumber !== "PHONE_NUMBER"
  ? { href: `tel:${site.phoneNumber}`, text: `📞 ${site.phoneNumber}` }
  : { href: "/contact/", text: "📞 Call for a Free Consultation" };
---

<Layout
  title={`Water Softener Systems in ${site.city}, ${site.stateAbbr}`}
  description={`Recommended water softener systems for ${site.city}, ${site.stateAbbr}. Systems selected and sized for ${site.gpgLow}–${site.gpgHigh} GPG hard water from ${site.waterAuthority}.`}
>
  <PageHero
    breadcrumbs={[{ label: "Products" }]}
    heading={`Water Softener Systems in ${site.city}, ${site.stateAbbr} | Trusted Local Specialists`}
    primaryCta={primaryCta}
    secondaryCta={{ href: "/quote/", text: "Get a Free Water Softener Quote in Albuquerque" }}
    image={headerImage}
  >
    <p slot="opening">
      <a href="/" class="brand-link">{site.city} Water Softener</a>
      {" "}offers recommended water softener systems, such as salt-based and combo filtration models, selected
      and sized for {site.city}'s {site.gpgLow}–{site.gpgHigh} GPG hard water from {site.waterAuthority}.
      Salt-free conditioners are not included since they do not remove hardness minerals at {site.gpgLow}
      –{site.gpgHigh} GPG. Free sizing consultation included with every free water test.
    </p>
  </PageHero>

  <QuickFacts />

  <section class="section">
    <div class="container">
      <div class="grid grid-3">
        <div class="card card-featured">
          <span class="badge">Most Popular</span>
          <p class="card-title">Salt-Based Water Softener</p>
          <p>Removes hardness minerals at {site.gpgLow}–{site.gpgHigh} GPG — the most effective option for {site.city}'s water, supplied by {site.waterAuthority}.</p>
          <ul class="feature-list">
            <li>Sized specifically for {site.gpgLow}–{site.gpgHigh} GPG hardness</li>
            <li>Removes calcium and magnesium, not just crystallizes them</li>
            <li>Protects water heaters and appliances from scale buildup</li>
            <li>Warranty terms are [PLACEHOLDER — confirm warranty terms]</li>
            <li>Free water hardness test included with every quote</li>
          </ul>
          <div class="card-ctas">
            <a class="btn btn-primary btn-sm" href={site.affiliateSoftener} target="_blank" rel="noopener noreferrer sponsored">Check Price &amp; Availability</a>
            <a class="card-secondary-cta" href="/quote/">Get a Free Water Softener Quote in Albuquerque</a>
          </div>
        </div>

        <div class="card">
          <p class="card-title">Softener + Whole-Home Filter Combo</p>
          <p>Pairs hardness removal with whole-home filtration for chlorine, sediment, and other contaminants carried through {site.waterAuthority}'s {site.waterSource} supply.</p>
          <ul class="feature-list">
            <li>All standalone softener features, plus filtration</li>
            <li>Removes chlorine taste and odor at every tap</li>
            <li>Reduces sediment carried through {site.waterSource}</li>
            <li>One system, one installation point, one warranty</li>
            <li>Sized to {site.city}'s {site.gpgLow}–{site.gpgHigh} GPG hardness</li>
          </ul>
          <div class="card-ctas">
            <a class="btn btn-primary btn-sm" href={site.affiliateCombo} target="_blank" rel="noopener noreferrer sponsored">Check Price &amp; Availability</a>
            <a class="card-secondary-cta" href="/quote/">Get a Free Water Softener Quote in Albuquerque</a>
          </div>
        </div>

        <div class="card">
          <p class="card-title">Reverse Osmosis System</p>
          <p>Under-sink drinking water purification for {site.city} homes. The cleanest possible glass of water from your tap.</p>
          <ul class="feature-list">
            <li>Removes dissolved solids standard filtration misses</li>
            <li>Improves the taste of drinking and cooking water</li>
            <li>Pairs with a softener for complete water treatment</li>
            <li>Compact under-sink installation</li>
            <li>Independent of {site.city}'s {site.gpgLow}–{site.gpgHigh} GPG softening system</li>
          </ul>
          <div class="card-ctas">
            <a class="btn btn-primary btn-sm" href={site.affiliateRO} target="_blank" rel="noopener noreferrer sponsored">Check Price &amp; Availability</a>
            <a class="card-secondary-cta" href="/quote/">Get a Free Water Softener Quote in Albuquerque</a>
          </div>
        </div>
      </div>
      <p class="disclosure">Some links above are affiliate links. We may earn a commission at no extra cost to you if you purchase through them.</p>
    </div>
  </section>

  <section class="section" style="background: var(--color-surface);">
    <div class="container">
      <div class="section-header center">
        <h2>Which System Size Does a {site.city} Home Need?</h2>
        <p>At {site.gpgLow}–{site.gpgHigh} GPG, system capacity should match household size — an undersized softener regenerates too often, while an oversized one wastes salt and water. Grain-capacity sizing guidance for local household sizes is [PLACEHOLDER — confirm sizing guidance], confirmed by {site.waterAuthority}'s own reading and your free in-home test.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>Compare Every System Type</h2>
        <p>See the full <a href="/comparison/">Water Softener Types Compared: Salt-Based vs. Salt-Free vs. Dual-Tank</a> page for a side-by-side breakdown, or explore <a href="/installation/">Water Softener Installation in Albuquerque: Process, Timeline &amp; Cost</a> for how each system gets installed.</p>
      </div>
    </div>
  </section>

  <section class="section section-dark">
    <div class="container final-cta">
      <h2>Ready for Soft Water in {site.city}?</h2>
      <p>{site.waterAuthority} reports the same {site.gpgLow}-{site.gpgHigh} GPG figure behind every system above — get a free quote for the right fit.</p>
      <a class="btn btn-primary" href="/quote/">Get a Free Water Softener Quote in Albuquerque</a>
    </div>
  </section>

  <style>
    .disclosure { font-size: 0.75rem; color: var(--color-text-muted); margin-top: 24px; }
    .final-cta { text-align: center; }

    .grid-3 { align-items: stretch; }
    .card { display: flex; flex-direction: column; }
    .card-title { font-family: var(--font-heading); font-size: 1.1rem; color: var(--surface-footer); margin: 0 0 8px; }
    .card-featured { position: relative; border: 1.5px solid var(--color-accent); }
    .card-featured .badge {
      position: absolute;
      top: -12px;
      left: 24px;
      background: var(--color-accent);
      color: #ffffff;
    }
    .feature-list { list-style: none; margin: 16px 0 20px; padding: 0; display: flex; flex-direction: column; gap: 8px; }
    .feature-list li {
      font-size: 0.875rem;
      color: var(--color-text-muted);
      padding-left: 22px;
      position: relative;
    }
    .feature-list li::before {
      content: "";
      position: absolute;
      left: 0;
      top: 7px;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--color-primary);
    }
    .card-ctas { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; margin-top: auto; padding-top: 4px; }
    .card-secondary-cta {
      font-family: var(--font-body);
      font-weight: 600;
      font-size: 0.875rem;
      color: var(--color-primary);
      text-decoration: none;
      transition: color var(--duration-micro) ease;
    }
    .card-secondary-cta:hover { color: var(--color-accent); }
    .card-secondary-cta:focus-visible { outline: 3px solid var(--color-primary); outline-offset: 2px; border-radius: 2px; }
    .card-secondary-cta:active { color: var(--color-accent-dark); }
  </style>
</Layout>
