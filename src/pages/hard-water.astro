---
import Layout from "../components/Layout.astro";
import PageHero from "../components/PageHero.astro";
import QuickFacts from "../components/QuickFacts.astro";
import { site } from "../lib/site";
import headerImage from "../assets/images/hard-water-header.jpg";

const primaryCta = site.phoneNumber && site.phoneNumber !== "PHONE_NUMBER"
  ? { href: `tel:${site.phoneNumber}`, text: `📞 ${site.phoneNumber}` }
  : { href: "/contact/", text: "📞 Call for a Free Consultation" };

const effects = [
  { name: "Appliance Damage", detail: `Scale buildup inside water heaters, dishwashers, and washing machines reduces efficiency, such as units running on ${site.city}'s ${site.gpgLow}-${site.gpgHigh} GPG supply, and can cut appliance lifespan measurably in ${site.gpgLabel.toLowerCase()} water areas.` },
  { name: "Pipe Scale", detail: `Mineral deposits narrow pipe diameter over time, reducing water pressure and increasing the risk of clogs in older ${site.city} homes.` },
  { name: "Skin and Hair Effects", detail: "Hard water leaves skin feeling dry and hair looking dull, since mineral residue interferes with soap and shampoo rinsing cleanly." },
];
---

<Layout
  title={`Hard Water Treatment in ${site.city}, ${site.stateAbbr}`}
  description={`Hard water effects in ${site.city}, ${site.stateAbbr}. ${site.city} water tests at ${site.gpgLow}–${site.gpgHigh} GPG from ${site.waterAuthority}. Learn how hard water damages appliances and how to protect your home.`}
>
  <PageHero
    breadcrumbs={[{ label: "Hard Water" }]}
    heading={`Hard Water Treatment in ${site.city}, ${site.stateAbbr} | Trusted Local Specialists`}
    primaryCta={primaryCta}
    secondaryCta={{ href: "/quote/", text: "Get a Free Water Softener Quote in Albuquerque" }}
    image={headerImage}
  >
    <p slot="opening">
      <a href="/" class="brand-link">Water Softeners of {site.city}</a>
      {" "}offers hard water effects treatment and scale prevention services, such as appliance protection and
      pipe-scale prevention, across {site.city} and {site.county} at {site.gpgLow}–{site.gpgHigh} GPG from
      {" "}{site.waterAuthority}. Sourced from {site.waterSource}, this supply leaves calcium and magnesium
      deposits on fixtures, inside appliances, and inside supply lines within weeks of installation. A
      salt-based ion exchange softener removes these minerals completely at the main water entry point. Free
      in-home water test available. Same day service.
    </p>
  </PageHero>

  <QuickFacts />

  <section class="section">
    <div class="container">
      <div class="section-header">
        <p>At {site.gpgLabel} levels, {site.city} tap water carries enough dissolved calcium and magnesium to leave visible and invisible damage throughout your home over time, such as the three patterns below.</p>
      </div>

      <div class="grid grid-3">
        {effects.map((e) => (
          <div class="card">
            <p class="card-title">{e.name}</p>
            <p>{e.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="background: var(--color-surface);">
    <div class="container">
      <div class="section-header">
        <h2>Visible Signs of Hard Water in {site.city}</h2>
        <p>{site.waterAuthority} reports {site.gpgLow}-{site.gpgHigh} GPG water produces five recognizable symptoms in a typical {site.city} home, such as spotting and reduced lather:</p>
      </div>
      <ul class="signs-list">
        <li>White, chalky spots on dishes, faucets, and shower glass</li>
        <li>Soap and shampoo that lathers poorly</li>
        <li>Stiff, scratchy laundry even after washing</li>
        <li>Reduced water pressure from scale-narrowed pipes</li>
        <li>Higher water heater energy bills</li>
      </ul>
      <p class="table-footnote">See the full <a href="/water-quality/">Albuquerque Water Quality Report: Hardness, Source &amp; Safety</a> for the reading behind every symptom above.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>Fixing Hard Water Effects at the Source</h2>
        <p>According to {site.waterAuthority}, a properly sized salt-based softener eliminates hardness minerals before they reach your plumbing and appliances, unlike a salt-free conditioner, which only crystallizes them rather than removing them. See the full <a href="/installation/">Water Softener Installation in Albuquerque: Process, Timeline &amp; Cost</a> page for how sizing works at {site.gpgLow}-{site.gpgHigh} GPG.</p>
      </div>
    </div>
  </section>

  <section class="section section-dark">
    <div class="container final-cta">
      <h2>Stop the Damage Before It Adds Up</h2>
      <p>{site.waterAuthority} reports the same {site.gpgLow}-{site.gpgHigh} GPG figure behind every symptom above — get a free water softener quote to protect your {site.city} home.</p>
      <a class="btn btn-primary" href="/quote/">Get a Free Water Softener Quote in Albuquerque</a>
    </div>
  </section>

  <style>
    .card-title { font-family: var(--font-heading); font-size: 1.1rem; color: var(--surface-footer); margin: 0 0 8px; }
    .signs-list { display: grid; gap: 12px; max-width: 640px; padding-left: 20px; }
    .table-footnote { margin-top: 16px; font-size: 0.85rem; color: var(--color-text-muted); }
    .final-cta { text-align: center; }
    .final-cta p { max-width: 48ch; margin: 0 auto 24px; }
  </style>
</Layout>
