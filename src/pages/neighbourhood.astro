---
import Layout from "../components/Layout.astro";
import PageHero from "../components/PageHero.astro";
import QuickFacts from "../components/QuickFacts.astro";
import { site } from "../lib/site";
import headerImage from "../assets/images/neighbourhood-header.jpg";

const primaryCta = site.phoneNumber && site.phoneNumber !== "PHONE_NUMBER"
  ? { href: `tel:${site.phoneNumber}`, text: `📞 ${site.phoneNumber}` }
  : { href: "/contact/", text: "📞 Call for a Free Consultation" };
---

<Layout
  title={`Water Softener Service Areas in ${site.city}, ${site.stateAbbr}`}
  description={`Water softener service areas in ${site.city}, ${site.stateAbbr}. We serve all ${site.city} neighbourhoods and surrounding ${site.county} communities. Free water test included with every consultation.`}
>
  <PageHero
    breadcrumbs={[{ label: "Neighbourhoods" }]}
    heading={`Water Softener Service Areas in ${site.city}, ${site.stateAbbr} | Trusted Local Specialists`}
    primaryCta={primaryCta}
    secondaryCta={{ href: "/quote/", text: "Get a Free Water Softener Quote in Albuquerque" }}
    image={headerImage}
  >
    <p slot="opening">
      <a href="/" class="brand-link">{site.city} Water Softener</a>
      {" "}provides water softener installation services across every {site.city} neighbourhood and surrounding
      {" "}{site.county} community, such as {site.neighbourhoods.slice(0, 2).join(" and ")}, at {site.gpgLow}
      –{site.gpgHigh} GPG from {site.waterAuthority}. Every neighbourhood receives the same {site.gpgLabel}
      water classification. Free in-home water test available across all service areas. Same day service. No
      obligation.
    </p>
  </PageHero>

  <QuickFacts />

  <section class="section">
    <div class="container">
      <div class="section-header">
        <p>We install and service water softeners, such as salt-based and combo systems, throughout {site.city}, {site.stateAbbr}. Every neighbourhood shares the same {site.gpgLow}–{site.gpgHigh} GPG ({site.gpgLabel}) water from {site.waterSource}. See the <a href="/water-quality/">Albuquerque Water Quality Report: Hardness, Source &amp; Safety</a> for the full citywide reading.</p>
      </div>
    </div>
  </section>

  {site.neighbourhoods.map((neighbourhood) => (
    <section class="section neighbourhood-section" id={neighbourhood.toLowerCase().replace(/\s+/g, "-")}>
      <div class="container">
        <h2>{neighbourhood}</h2>
        <p>
          Homeowners in {neighbourhood} deal with the same {site.gpgLow}–{site.gpgHigh} GPG,
          {" "}{site.gpgLabel.toLowerCase()} water as the rest of {site.city}. This supply comes from
          {" "}{site.waterSource}. According to {site.waterAuthority}, this reading holds steady across every
          {" "}{neighbourhood} address, so sizing follows the same confirmed number as the rest of {site.city}.
          {" "}Get a free quote for {neighbourhood}.
        </p>
        <a class="btn btn-secondary btn-sm neighbourhood-cta" href="/quote/">Get a Free Water Softener Quote in Albuquerque</a>
      </div>
    </section>
  ))}

  <section class="section section-dark">
    <div class="container final-cta">
      <h2>Don't See Your Neighbourhood?</h2>
      <p>We serve all of {site.city} and surrounding {site.county}. {site.waterAuthority} reports the same {site.gpgLow}-{site.gpgHigh} GPG figure applies wherever you are. Reach out for a free quote.</p>
      <a class="btn btn-primary" href="/quote/">Get a Free Water Softener Quote in Albuquerque</a>
    </div>
  </section>

  <style>
    .neighbourhood-section:nth-of-type(odd) { background: var(--color-surface); }
    .neighbourhood-section h2 { margin-bottom: 8px; }
    .neighbourhood-section { scroll-margin-top: 120px; }
    .neighbourhood-cta { margin-top: 16px; }
    .neighbourhood-cta:not(:hover) { color: var(--color-primary); border-color: var(--color-primary); }
    .final-cta { text-align: center; }
    .final-cta p { max-width: 48ch; margin: 0 auto 24px; }
  </style>
</Layout>
