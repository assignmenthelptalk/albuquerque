---
import Layout from "../components/Layout.astro";
import PageHero from "../components/PageHero.astro";
import QuoteForm from "../components/QuoteForm.astro";
import QuickFacts from "../components/QuickFacts.astro";
import { site } from "../lib/site";
import headerImage from "../assets/images/quote-header.jpg";

const primaryCta = site.phoneNumber && site.phoneNumber !== "PHONE_NUMBER"
  ? { href: `tel:${site.phoneNumber}`, text: `📞 ${site.phoneNumber}` }
  : { href: "/contact/", text: "📞 Call for a Free Consultation" };
---

<Layout
  title={`Free Water Softener Quote in ${site.city}, ${site.stateAbbr}`}
  description={`Request a free, no-obligation water softener quote for your home in ${site.city}, ${site.stateAbbr}. Confirmed against ${site.waterAuthority}'s ${site.gpgLow}-${site.gpgHigh} GPG reading.`}
>
  <PageHero
    breadcrumbs={[{ label: "Get a Quote" }]}
    heading={`Free Water Softener Quote in ${site.city}, ${site.stateAbbr} | Trusted Local Specialists`}
    primaryCta={primaryCta}
    secondaryCta={{ href: "/installation/", text: "Water Softener Installation in Albuquerque: Process, Timeline & Cost" }}
    image={headerImage}
  >
    <p slot="opening">
      <a href="/" class="brand-link">{site.businessName}</a>
      {" "}provides free water testing and no-obligation quotes, such as in-home and virtual options, across
      {" "}{site.city} and {site.county} at {site.gpgLow}–{site.gpgHigh} GPG from {site.waterAuthority}. Every
      quote starts with a free in-home water hardness test confirming your exact reading. Pricing confirmed in
      writing before any work begins. No surprise charges. No obligation to proceed.
    </p>
  </PageHero>

  <QuickFacts />

  <section class="section quote-section">
    <div class="container quote-grid">
      <div>
        <h2>What Your Free Quote Includes</h2>
        <p>Tell us a bit about your home, such as household size and fixture count, and we'll follow up with a no-obligation recommendation and price, sized for {site.city}'s {site.gpgLow}–{site.gpgHigh} GPG water. According to {site.waterAuthority}, this reading holds across {site.county}. See the full quote form below to get started.</p>
        <ul class="quote-benefits">
          <li>Free in-home or virtual water hardness test</li>
          <li>No-obligation, transparent pricing</li>
          <li>Local installation across {site.county}</li>
        </ul>
        {site.phoneNumber !== "PHONE_NUMBER" && (
          <p class="quote-phone">Prefer to talk now? Call <a href={`tel:${site.phoneNumber}`}>{site.phoneNumber}</a></p>
        )}
        <p class="quote-links">See the <a href="/installation/">Water Softener Installation in Albuquerque: Process, Timeline &amp; Cost</a> page or the <a href="/faq/">Water Softener FAQs for Albuquerque Homeowners</a> for more detail before you request a quote.</p>
      </div>
      <QuoteForm />
    </div>
  </section>

  <style>
    .quote-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 48px;
      align-items: start;
    }
    .quote-benefits { padding-left: 20px; color: var(--color-text-muted); }
    .quote-benefits li { margin-bottom: 8px; }
    .quote-phone { margin-top: 24px; font-weight: 600; }
    .quote-links { margin-top: 16px; font-size: 0.9rem; color: var(--color-text-muted); }
    @media (max-width: 860px) {
      .quote-grid { grid-template-columns: 1fr; }
    }
  </style>
</Layout>
